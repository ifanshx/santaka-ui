{
  "name": "@santaka-ui/vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter for Santaka UI components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifanshx/santaka-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://santaka.my.id",
  "bugs": {
    "url": "https://github.com/ifanshx/santaka-ui/issues"
  },
  "author": {
    "name": "ifanshx",
    "url": "https://github.com/ifanshx"
  },
  "keywords": [
    "design-system",
    "vue",
    "ui",
    "components",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:package": "publint . && attw --pack --profile esm-only --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@santaka-ui/utilities": "workspace:^"
  },
  "peerDependencies": {
    "@santaka-ui/web-components": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@santaka-ui/web-components": "workspace:^",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "jsdom": "30.1.2",
    "publint": "0.3.25",
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vue": "3.5.44"
  }
}
