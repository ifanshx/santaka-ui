{
  "name": "@santaka-ui/styles",
  "version": "0.1.0",
  "description": "Santaka UI reset, base element styles, focus-ring and visually-hidden primitives, and the glass overlay surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifanshx/santaka-ui.git",
    "directory": "packages/styles"
  },
  "homepage": "https://santaka.my.id",
  "bugs": {
    "url": "https://github.com/ifanshx/santaka-ui/issues"
  },
  "author": {
    "name": "ifanshx",
    "url": "https://github.com/ifanshx"
  },
  "keywords": [
    "design-system",
    "css",
    "reset",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css",
    "./primitives.css": "./dist/primitives.css",
    "./index.css": "./dist/index.css",
    "./glass.css": "./dist/glass.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm --filter @santaka-ui/tokens build && node scripts/build-styles.mjs --check",
    "size": "echo \"[styles] CSS budgets are measured with the component stylesheet\"",
    "validate:package": "publint . && attw --pack --profile esm-only --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "peerDependencies": {
    "@santaka-ui/tokens": "workspace:^"
  },
  "devDependencies": {
    "@santaka-ui/tokens": "workspace:^",
    "eslint": "9.39.5",
    "publint": "0.3.25",
    "rimraf": "6.0.1",
    "typescript": "5.9.3"
  }
}
