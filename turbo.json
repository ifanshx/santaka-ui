{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "**/.env.*local"],
  // Half the available CPUs, not turbo's default of ten concurrent tasks.
  //
  // The default does not look at the machine, and every test task here is itself
  // a runner that opens one worker process per core: eight packages × a
  // six-worker pool on a six-core machine is dozens of processes competing for
  // the same six cores. The symptom was vitest failing to start a forks worker —
  // `Timeout waiting for worker to respond` — in whichever package lost the race,
  // which meant a `verify` run failed on a package nobody had touched. Bounding
  // the task count is the fix that matches the cause; raising the worker timeout
  // would only move it.
  "concurrency": "50%",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `.next/**` is the Next.js example's build output; without it turbo
      // reports "no output files found" and the example's build is never
      // cached. `.next/cache/**` is excluded because it is Next's own
      // incremental build cache (67 MB of the 69 MB here) — caching it in
      // turbo too would double the storage for no benefit.
      "outputs": ["dist/**", "www/**", "loader/**", ".stencil/**", ".next/**", "!.next/cache/**"]
    },
    // `build` alongside `^build` on the tasks below, not just on `test`: three of
    // `core`'s scripts (`pretest`, `pretypecheck`, and the build itself) read or
    // regenerate files under its own `dist/`. Depending on *upstream* builds alone
    // leaves a clean checkout running them against output that does not exist yet.
    // It passes locally for months because `dist/` is already there from an
    // earlier build, and fails on a CI runner the first time the cache is cold —
    // which is exactly how a green local `verify` shipped a red CI run.

    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test": {
      // See the note above `typecheck` for why `build` is listed here too.
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**", "playwright-report/**", "test-results/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "^test"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "validate:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
