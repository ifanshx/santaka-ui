{
  "name": "@santaka-ui/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook workshop for the Santaka UI component set (docs/ARCHITECTURE.md section 10).",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006",
    "build": "storybook build --quiet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rimraf storybook-static node_modules/.cache"
  },
  "dependencies": {
    "@santaka-ui/react": "workspace:^",
    "@santaka-ui/styles": "workspace:^",
    "@santaka-ui/tokens": "workspace:^",
    "@santaka-ui/web-components": "workspace:^",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "9.39.5",
    "playwright": "1.64.0",
    "rimraf": "6.0.1",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
