{
  "name": "@santaka-ui/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Santaka UI documentation site (ADR-006). Astro, content from the registry, Pagefind search.",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "clean": "rimraf dist .astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@santaka-ui/core": "workspace:^",
    "@santaka-ui/mcp": "workspace:^",
    "@santaka-ui/web-components": "workspace:^",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "rimraf": "6.0.1",
    "typescript": "5.9.3"
  }
}
