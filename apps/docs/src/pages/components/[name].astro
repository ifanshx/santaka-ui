---
/**
 * One component page, generated (ADR-006).
 *
 * Every field below comes from the registry entry. There is no prose here that a
 * component could contradict, which is the invariant `tests/registry/docs-source.test.mjs`
 * asserts against `llms-full.txt`: a hand-edited page fails.
 */
import Layout from "../../layouts/Layout.astro"
import Preview from "../../components/Preview.astro"
import { componentPages } from "../../lib/components"

/**
 * Components that render something meaningful from an empty tag.
 *
 * Curated, not derived: the registry has no "required" flag, so there is no data
 * to decide from. Adding one would be the right fix; until then the list is
 * explicit rather than pretending to be derived — the same honesty rule the
 * generator's authored prose follows.
 */
const PREVIEWABLE = ["badge", "button", "card", "separator", "skeleton", "spinner", "text", "link"]

export function getStaticPaths() {
  return componentPages().map((page) => ({
    params: { name: page.name },
    props: { page },
  }))
}

const { page } = Astro.props
---

<Layout title={`${page.tag} — Santaka UI`} description={page.summary}>
  <p class="crumbs"><a href="/">Components</a> / {page.tag}</p>

  <header class="head">
    <h1>{page.tag}</h1>
    <span class={`badge badge--${page.stability}`}>{page.stability}</span>
  </header>

  <p class="summary">{page.summary}</p>

  <div class="meta">
    <div><span>Behavior owner</span><strong>{page.behaviorOwner}</strong></div>
    <div><span>Version</span><strong>{page.version}</strong></div>
    <div><span>Locales</span><strong>{page.locales.join(", ") || "none"}</strong></div>
    <div><span>Frameworks</span><strong>{page.frameworks.join(", ")}</strong></div>
  </div>

  <section>
    <h2>When to use</h2>
    <ul>{page.whenToUse.map((entry) => <li>{entry}</li>)}
    </ul>
  </section>

  <section>
    <h2>When not to use</h2>
    <ul>{page.whenNotToUse.map((entry) => <li>{entry}</li>)}
    </ul>
  </section>

  <section>
    <h2>Example</h2>
    <pre><code>{page.example}</code></pre>
  </section>

  {
    // Preview only the components that render something meaningful from an empty
    // tag. A Toast or a Dialog needs state to open, and a form control needs a
    // `name` to be worth showing, so an empty-tag preview of those would be an
    // empty box — worse than no preview.
    //
    // This is a curated list, and the honesty matters: the registry does not
    // carry a "required" flag, so there is no data here to derive the decision
    // from. Adding one would be the right fix; until then the list is explicit
    // rather than pretending to be derived.
    PREVIEWABLE.includes(page.name) && (
      <section>
        <h2>Live preview</h2>
        <Preview tag={page.tag} attrs={{}} text={page.name} />
      </section>
    )
  }

  <section>
    <h2>Accessibility</h2>
    <p>{page.accessibility}</p>
  </section>

  {page.props.length > 0 && (
    <section>
      <h2>Props</h2>
      <table>
        <thead>
          <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
        </thead>
        <tbody>
          {page.props.map((prop) => (
            <tr>
              <td><code>{prop.name}</code></td>
              <td><code>{prop.type}</code></td>
              <td>{prop.default === null ? "—" : <code>{prop.default}</code>}</td>
              <td>{prop.description || "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {page.events.length > 0 && (
    <section>
      <h2>Events</h2>
      <ul>{page.events.map((event) => <li><code>{event}</code></li>)}</ul>
    </section>
  )}

  {page.limitations.length > 0 && (
    <section>
      <h2>Known limitations</h2>
      <ul>{page.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
    </section>
  )}

  {page.cssVariables.length > 0 && (
    <section>
      <h2>CSS variables it needs</h2>
      <p class="hint">
        §9: the CLI warns when one of these is undefined rather than failing silently.
      </p>
      <ul class="vars">{page.cssVariables.map((name) => <li><code>{name}</code></li>)}</ul>
    </section>
  )}

  <footer class="note">
    <p>
      This page is generated from <a href={`/registry/${page.name}.json`}>{`registry/${page.name}.json`}</a>.
    </p>
  </footer>
</Layout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .summary {
    font-size: 1.1rem;
    max-inline-size: 65ch;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
    padding: 0;
  }
  .meta div {
    border: var(--stroke) solid var(--edge);
    padding: 0.5rem 0.75rem;
  }
  .meta span {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  table {
    border-collapse: collapse;
    inline-size: 100%;
  }
  th,
  td {
    text-align: start;
    padding: 0.4rem 0.6rem;
    border-block-end: 1px solid var(--edge);
    vertical-align: top;
  }
  pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border: var(--stroke) solid var(--edge);
  }
  .vars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .vars li {
    font-size: 0.8rem;
    border: 1px solid var(--edge);
    padding: 0.1rem 0.4rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    border: 1px solid currentColor;
  }
  .badge--stable {
    color: #0d9488;
  }
  .badge--preview,
  .badge--experimental {
    color: #b45309;
  }
  .badge--deprecated {
    color: #b91c1c;
  }
  .note {
    margin-block-start: 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
