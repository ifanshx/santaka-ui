---
/**
 * Component catalogue index (§10, "searchable component catalog").
 *
 * Grouped by stability, because §10 asks for separate Stable / Preview /
 * Experimental / Deprecated labels — and the labels come from the registry
 * rather than from an author's heading (ADR-006).
 *
 * The page is built from the system's own components — `<sk-button>`,
 * `<sk-card>`, `<sk-badge>`, `<sk-text>`, `<sk-separator>` — rather than from
 * bespoke CSS that imitates them. A design system's own site is the first
 * demonstration of the system; styling it by hand is an argument that the
 * components are not good enough to use.
 */
import Layout from "../layouts/Layout.astro"
import { blockPages, componentPages, stabilityGroups } from "../lib/components"

const pages = componentPages()
const groups = stabilityGroups()
const blocks = blockPages()

const install = "pnpm add @santaka-ui/web-components @santaka-ui/tokens @santaka-ui/styles"
---

<Layout
  wide
  title="Santaka UI — one design system, every framework"
  description={`${pages.length} accessible web components with thin React, Vue, and Svelte adapters. Tokens, a CLI, a versioned registry, and MCP metadata — no framework lock-in.`}
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
    <sk-badge variant="primary" size="sm">Design system</sk-badge>

    {/* A real <h1>. The page previously had none: `sk-text` renders a <span>,
        so the headline looked like a headline and was semantically nothing —
        no document outline, no first landmark for a screen reader. Typography
        cannot fix that. The element is real; its treatment reuses the display
        token so the semantic fix does not restyle the page by hand. */}
    <h1 class="headline">
      One design system.<br />Every framework.<br /><span class="accent">Your code.</span>
    </h1>

    <sk-text variant="lg" muted class="lede">
      {pages.length} accessible components built as web components, with thin adapters for React, Vue, and Svelte. The
      behavior lives in one place, so an app in any framework gets the same keyboard model, the same ARIA wiring, and the
      same bug fixes. Zero runtime dependencies — and all {pages.length} components are filterable right here on this page.
    </sk-text>

    <div class="cta">
      <sk-button variant="primary" size="lg" href="/quick-start">Quick start</sk-button>
      <sk-button variant="outline" size="lg" href="/showcase">See them rendered</sk-button>
    <div class="install">
      <sk-text variant="sm" muted>Install</sk-text>
      {/* The copy control sits inside the code block, the way shadcn/ui and
          most developer documentation do, rather than beside it as a second
          box with its own shadow. Two adjacent bordered boxes read as two
          components; one box with a control in it reads as one. */}
      <div class="install-row">
        <pre tabindex="0" aria-label="Install command, scrollable"><code>{install}</code></pre>
        <sk-button
          class="install-copy"
          variant="ghost"
          size="sm"
          id="copy-install"
          data-copy={install}
          aria-label="Copy the install command"
        >
          Copy
        </sk-button>
      </div>
    </div>
    </div>

    </div>

    <aside class="hero-demo" aria-label="Live component preview">
      <div class="demo-chrome" aria-hidden="true">
        <span class="dot dot-danger"></span>
        <span class="dot dot-amber"></span>
        <span class="dot dot-green"></span>
        <span class="demo-title">santaka — playground</span>
      </div>
      <div class="demo-body">
        <sk-tabs active={0}>
          <sk-tab label="Overview">One behaviour owner, three adapters. Same keyboard model everywhere.</sk-tab>
          <sk-tab label="Tokens">Override a custom property; every component follows.</sk-tab>
        </sk-tabs>
        <div class="demo-row">
          <sk-input label="Email" type="email" placeholder="you@example.com" size="sm" />
          <sk-button variant="primary" size="sm">Save</sk-button>
        </div>
        <sk-slider label="Volume" value={40} show-value format="%" />
        <sk-progress value={72} label="Uploading" />
        <div class="demo-row">
          <sk-kbd>⌘</sk-kbd>
          <sk-kbd>K</sk-kbd>
          <sk-text variant="sm" muted>opens the command palette anywhere</sk-text>
        </div>
      </div>
    </aside>

  </section>

  <section class="facts" aria-label="At a glance">
    <sk-card variant="default" padding="sm">
      <sk-text variant="2xl" family="display" class="stat">{pages.length}</sk-text>
      <sk-text variant="sm" muted>Components</sk-text>
    </sk-card>
    <sk-card variant="default" padding="sm">
      <sk-text variant="2xl" family="display" class="stat">{blocks.length}</sk-text>
      <sk-text variant="sm" muted>Blocks</sk-text>
    </sk-card>
    <sk-card variant="default" padding="sm">
      <sk-text variant="2xl" family="display" class="stat">1</sk-text>
      <sk-text variant="sm" muted>Behavior owner</sk-text>
    </sk-card>
    <sk-card variant="default" padding="sm">
      <sk-text variant="2xl" family="display" class="stat">0</sk-text>
      <sk-text variant="sm" muted>Runtime deps</sk-text>
    </sk-card>
  </section>

  {/* A live bento, not a list of names: the reader should see the components
      working before they read a word about them. Every panel below is real
      markup from the system — nothing is a screenshot. */}
  <section class="bento" aria-label="Live components">
    <sk-card class="bento-form" heading="Controls" padding="md">
      <div class="bento-stack">
        <sk-input label="Email" type="email" placeholder="you@example.com" />
        <sk-combobox
          label="Plan"
          placeholder="Search a plan…"
          options={JSON.stringify([
            { value: "free", label: "Free" },
            { value: "pro", label: "Pro" },
            { value: "team", label: "Team" },
            { value: "enterprise", label: "Enterprise" },
          ])}
        />
        <sk-checkbox label="Email me about releases" />
        <div class="bento-row">
          <sk-button variant="primary" size="sm">Save</sk-button>
          <sk-button variant="ghost" size="sm">Cancel</sk-button>
        </div>
      </div>
    </sk-card>

    <sk-card class="bento-signal" heading="Status" padding="md">
      <div class="bento-stack">
        <div class="bento-row">
          <sk-badge variant="success" size="sm">Stable</sk-badge>
          <sk-badge variant="warning" size="sm">Preview</sk-badge>
          <sk-badge variant="danger" size="sm">Deprecated</sk-badge>
        </div>
        <sk-alert variant="success" heading="Saved">Your changes are live.</sk-alert>
        <sk-progress value={72} label="Uploading" />
      </div>
    </sk-card>

    <sk-card class="bento-people" heading="Avatars" padding="md">
      <div class="bento-stack">
        <sk-avatar-group>
          <sk-avatar name="Grace Hopper" />
          <sk-avatar name="Ada Lovelace" />
          <sk-avatar name="Alan Turing" />
        </sk-avatar-group>
        <sk-text variant="sm" muted>A group collapses to a count when it runs out of room.</sk-text>
      </div>
    </sk-card>

    <sk-card class="bento-tabs" heading="Tabs" padding="md">
      <sk-tabs active={0}>
        <sk-tab label="Overview">One behaviour owner, three adapters.</sk-tab>
        <sk-tab label="Tokens">Override a custom property; nothing else changes.</sk-tab>
      </sk-tabs>
    </sk-card>

    <sk-card class="bento-slider" heading="Range" padding="md">
      <div class="bento-stack">
        <sk-slider label="Volume" value={40} show-value format="%" />
        <sk-switch label="Reduce motion" />
      </div>
    </sk-card>

    <sk-card class="bento-table" heading="Table" padding="none">
      <sk-table striped compact>
        <table>
          <thead>
            <tr><th>Component</th><th>Owner</th></tr>
          </thead>
          <tbody>
            <tr><td><code>sk-button</code></td><td>web-components</td></tr>
            <tr><td><code>sk-dialog</code></td><td>web-components</td></tr>
            <tr><td><code>sk-select</code></td><td>web-components</td></tr>
          </tbody>
        </table>
      </sk-table>
    </sk-card>

    {/* Overlays: the components a reader cannot judge from a static image,
        because their whole job is what happens after a click. A popover and a
        drawer are here rather than described, so focus trapping and Escape can
        be tried on the page that claims them. */}
    <sk-card class="bento-overlays" heading="Overlays" padding="md">
      <div class="bento-stack">
        <div class="bento-row">
          <sk-popover label="More about focus behaviour">
            <sk-button slot="trigger" variant="outline" size="sm">Open popover</sk-button>
            <div class="popover-body">
              <sk-text variant="sm">
                Focus moves in on open and returns to the trigger on close. Escape closes it.
              </sk-text>
            </div>
          </sk-popover>

          <sk-drawer label="Component details" side="end">
            <sk-button slot="trigger" variant="outline" size="sm">Open drawer</sk-button>
            <div class="drawer-body">
              <sk-text variant="sm">
                A drawer is a modal dialog that slides from an edge. Focus is trapped while it is
                open, Escape closes it, and focus returns to the trigger.
              </sk-text>
            </div>
          </sk-drawer>
        </div>

        <div class="bento-row">
          <sk-text variant="sm" muted>
            Search with <sk-kbd>⌘</sk-kbd> <sk-kbd>K</sk-kbd> anywhere on the site
          </sk-text>
        </div>

        <sk-tooltip>
          <sk-button slot="trigger" variant="ghost" size="sm">Hover for a tooltip</sk-button>
          <span>Tooltips delay 300ms and dismiss on Escape</span>
        </sk-tooltip>
      </div>
    </sk-card>

    {/* Loading and paging. A skeleton is the one component that only makes
        sense in motion, and pagination is the one that only makes sense with
        more than one page — so both are shown in the state they exist for. */}
    <sk-card class="bento-loading" heading="Loading" padding="md">
      <div class="bento-stack">
        <sk-skeleton variant="text" />
        <sk-skeleton variant="text" />
        <sk-spinner size="sm" label="Loading components" />
        <sk-pagination page={3} count={12} />
      </div>
    </sk-card>
  </section>
  <sk-separator decorative />

  {/* The architecture explained with the system's own disclosure component.
      The same four points were four static cards: correct, but they asked the
      reader to read four paragraphs to learn one idea. An accordion lets the
      page show the shape of the argument — one behaviour owner, three adapters
      — and let the reader open only the part they doubt. */}
  <section class="how">
    <p class="section-eyebrow" aria-hidden="true">01 — Architecture</p>
    <h2 class="section-title">How it works</h2>
    <sk-text variant="sm" muted class="section-lede">
      One implementation, three adapters. Open the step you want evidence for.
    </sk-text>

    <sk-accordion class="how-accordion">
      <sk-accordion-item heading="1. The behaviour lives in the custom element" open>
        <sk-text variant="sm">
          ARIA wiring, the keyboard model, and form participation are implemented once, in
          <code>sk-*</code>. A screen reader gets the same roles whether the page is React or plain HTML, because it is
          the same element either way.
        </sk-text>
      </sk-accordion-item>

      <sk-accordion-item heading="2. The adapters translate props, nothing else">
        <sk-text variant="sm">
          React and Vue packages map props and events to the element and stop there. Measured: the largest adapter file
          is 1.1 KB, and no adapter reimplements focus management or ARIA.
        </sk-text>
      </sk-accordion-item>

      <sk-accordion-item heading="3. Tokens are the whole theming contract">
        <sk-text variant="sm">
          Override <code>--sk-color-primary</code> on any scope and every component inside it follows. No provider, no
          build step, no runtime — which is why the docs site can be themed by changing one declaration.
        </sk-text>
      </sk-accordion-item>

      <sk-accordion-item heading="4. The registry is the single source">
        <sk-text variant="sm">
          This page, every component page, the CLI, the MCP server, and <code>llms.txt</code> are all generated from one
          registry. A prop rename cannot reach one surface and miss another.
        </sk-text>
      </sk-accordion-item>
    </sk-accordion>
  </section>

  {/* Every component on one page, filterable. The catalogue used to be four
      separate grids the reader scrolled past; with 38 tags, finding one meant
      knowing its name. The search field and the stability filter are the
      system's own `sk-input` and `sk-select`, so the page demonstrates the
      components it is indexing — and `sk-empty-state` handles the case where
      the filter excludes everything rather than leaving a blank grid. */}
  <section class="catalogue" id="components">
    <div class="catalogue-head">
    <p class="section-eyebrow" aria-hidden="true">02 — Library</p>
      <h2 class="section-title">All components</h2>
      <sk-badge variant="primary" size="sm">{pages.length}</sk-badge>
    </div>

    <div class="filters">
      <sk-input
        id="filter-search"
        label="Search components"
        type="search"
        placeholder="button, dialog, toast…"
        size="sm"
      />
      <sk-select
        id="filter-stability"
        value="all"
        label="Stability"
        size="sm"
        options={JSON.stringify([
          { value: "all", label: "All" },
          ...groups.map((g) => ({ value: g.label, label: `${g.label} (${g.pages.length})` })),
        ])}
      />
    </div>

    <div class="cards" id="catalogue-grid">
      {pages.map((page) => (
        <a
          class="card-link"
          href={`/components/${page.name}/`}
          data-name={page.name}
          data-tag={page.tag}
          data-summary={page.summary}
          data-stability={page.stability}
        >
          <sk-card variant="default" padding="sm" heading={page.tag}>
            <sk-text variant="sm" muted>{page.summary}</sk-text>
            <div class="card-meta">
              <sk-badge
                variant={page.stability === "stable" ? "success" : "warning"}
                size="sm"
              >
                {page.stability}
              </sk-badge>
            </div>
          </sk-card>
        </a>
      ))}
    </div>
    {/* Twelve on load, the rest on request. All 38 at once made this section
        2,353px — 42% of the page, and a reader had to scroll past two screens of
        cards to reach anything below. shadcn's entire landing page is 1,893px.
        The filter still searches all 38, so nothing becomes harder to find;
        only the initial height is capped. */}
    <div class="catalogue-more">
      <sk-button id="catalogue-toggle" variant="outline" size="sm">Show all components</sk-button>
    </div>

    <sk-empty-state id="catalogue-empty" heading="No components match" description="Try a shorter search or a different stability filter." hidden />
  </section>

  {
    // Blocks are not components: they have no tag, no props, and no page-sized
    // preview (ADR-022), so they get their own section rather than a card in a
    // stability group where a reader would look for an element to import.
    blocks.length > 0 && (
      <section class="group" id="blocks">
        <div class="group-head">
          <p class="section-eyebrow" aria-hidden="true">03 — Compositions</p>
          <h2 class="section-title">Blocks</h2>
          <sk-badge variant="neutral" size="sm">
            {blocks.length}
          </sk-badge>
        </div>
        <sk-text variant="sm" muted class="hint">
          Page compositions: markup that uses the components above, plus layout CSS. <code>santaka add</code> installs a
          block together with every component it composes.
        </sk-text>
        <div class="cards">
          {blocks.map((page) => (
            <a class="card-link" href={`/blocks/${page.name}/`}>
              <sk-card variant="default" padding="sm" heading={page.name}>
                <sk-text variant="sm" muted>
                  {page.summary}
                </sk-text>
              </sk-card>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <sk-separator decorative />

  {/* The terminal material from Santaka-Pay: dark chrome, three status dots,
      monospace — the visual shorthand for "this is where the machine reads".
      The registry links are the payload; the chrome tells an agent-minded
      reader they are in the right place. */}
  <section class="machine">
    <div class="machine-shell">
      <div class="demo-chrome" aria-hidden="true">
        <span class="dot dot-danger"></span>
        <span class="dot dot-amber"></span>
        <span class="dot dot-green"></span>
        <span class="demo-title">santaka — machine registry</span>
      </div>
      <div class="machine-body">
    <p class="section-eyebrow" aria-hidden="true">04 — Machine registry</p>
    <h2 class="section-title">For machines</h2>
    <sk-text variant="sm" muted>
      The same registry is served three ways, so an agent, an editor, or a script does not have to scrape this page.
    </sk-text>
    <ul class="links">
      <li>
        <a href="/registry/index.json"><code>registry/index.json</code></a> — every item, versioned and checksummed
      </li>
      <li>
        <a href="/llms.txt"><code>llms.txt</code></a> — the inventory as prose, for a model's context window
      </li>
      <li>
        <a href="/llms-full.txt"><code>llms-full.txt</code></a> — props, events, and limitations for every component
      </li>
      <li>
        <a href="/schema/registry-item-v1.json"><code>registry-item-v1.json</code></a> — the JSON Schema entries validate against
      </li>
    </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Layout only. Every visual decision — stroke, shadow, colour, radius, motion —
     comes from the components and the tokens. What is left here is where things
     sit, because that is the one thing a component cannot decide for a page.

     Vertical rhythm is one token-driven step. The sections previously used
     32px, 44px and 40px margins from three unrelated rules, which read as
     uneven even though no single value was wrong; --docs-rhythm makes the
     spacing between every band identical and the gaps inside them smaller. */

  :root {
    --docs-rhythm: clamp(2.5rem, 5vw, 4rem);
  }

  .hero {
    position: relative;
    isolation: isolate;
    /* The glow is oversized by design; clip it to the hero so it never pushes
       the document wider than the viewport. */
    overflow: clip;
    padding-block: clamp(1.5rem, 4vw, 3rem) 0;
  }

  /* 2026 idiom: one soft radial glow behind the hero copy, in the primary
     hue at very low alpha. Decorative only (aria-hidden), and a single
     element — no gradient banner, no grid of sparkles. */
  .hero-glow {
    position: absolute;
    inset-block-start: -20%;
    inset-inline-start: 38%;
    z-index: -1;
    inline-size: min(52rem, 64vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--sk-color-primary) 22%, transparent),
      transparent 70%
    );
    filter: blur(10px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      filter: none;
    }
  }
  .hero {
    /* Two-column hero: copy left, live demo right. Fills the right-hand void
       the page was criticized for, and the demo panel is REAL components — the
       same trick as the bento, moved above the fold. */
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero-demo {
    display: block;
    border: var(--docs-stroke) solid var(--sk-color-ink, #1b1714);
    border-radius: var(--sk-radius-lg, 6px);
    background: var(--sk-color-ink, #1b1714);
    color: var(--sk-color-ink-50, #faf5ec);
    box-shadow: var(--sk-shadow-brutal, 5px 5px 0 0);
    overflow: hidden;
    /* The muted-text token is tuned for light surfaces (3.5:1 on ink). Inside
       the dark demo panel it must flip to a warm light tone or every secondary
       line — tab labels, helper text — fails WCAG AA. Scoped override, so the
       components' own styling still applies everywhere else. */
    --sk-color-text-muted: #C9BCA8;
  }

  .demo-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-block-end: 2px solid var(--sk-color-ink-200, #e8dfcd);
  }

  .demo-title {
    font-family: var(--docs-code);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-inline-start: 0.35rem;
  }

  .dot {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: var(--sk-radius-full, 9999px);
  }
  .dot-danger { background: var(--sk-color-danger-fill, #e23b2e); }
  .dot-amber { background: var(--color-secondary-cta, #ffc531); }
  .dot-green { background: var(--color-primary-cta, #19c463); }

  .demo-body {
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .demo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.6rem;
  }

  @media (max-width: 62rem) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-demo {
      margin-block-start: 0.5rem;
    }
  }

  /* The measure of the page. The headline was 52px on a 992px column, which is
     8% of the width — large, but the lede below it was only 18px against a
     62ch line, so the drop from title to body was abrupt and the page read as a
     document with a big first line. The steps below are a deliberate scale:
     title, lede, section title — each about 60% of the one above, so the eye
     moves down the page instead of jumping. */
  /* Measured against shadcn/ui, whose hero is 48px at weight 600: the weight
     carries the emphasis there, not the size. This was 68px at 800 on a 1.02
     line-height, which is loud and leaves no room above it for anything else.
     56px at 750 on 1.05 keeps the display weight but gives the line air, and
     text-wrap: balance keeps the three short lines even instead of ragged. */
  .headline {
    display: block;
    margin-block: 1rem 0;
    font-family: var(--sk-font-display, inherit);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .accent {
    color: var(--sk-color-primary);
  }

  .lede {
    display: block;
    margin-block-start: 1.5rem;
    max-inline-size: 58ch;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block: 1.75rem 1.5rem;
  }

  /* grid-template-columns on the container, because the label is an inline-
     level box that otherwise took the width of its longest possible line: it
     measured 625px inside a 390px viewport and pushed the page wider. */
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    max-inline-size: 46rem;
  }

  .install > sk-text {
    display: block;
    min-inline-size: 0;
  }

  /* min-inline-size: 0 is what makes the code block shrink instead of pushing
     the page wider. A flex item minimum defaults to its content size, so a long
     one-line command forced the row to 582px inside a 390px viewport — a
     horizontal scrollbar on every phone. Clearing the minimum lets the
     overflow-x on the pre do its job. */
  .install-row {
    display: flex;
    align-items: stretch;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .install-row pre {
    flex: 1 1 14rem;
    min-inline-size: 0;
    margin: 0;
    /* Same elevation as every other raised surface: the code block is a card
       with a monospace face, not a flat panel. Without this it was the one
       surface on the page with a stroke and no shadow. The end padding keeps
       the command readable at rest instead of running under the copy control. */
    border-radius: var(--sk-radius-md, 4px);
    padding-inline-end: 5.5rem;
  }

  /* Positioned into the code block instead of after it: the row is the
     positioned ancestor, and the control is lifted out of the flow so it does
     not add a second box. It keeps its own focus ring and stays a real button,
     so the affordance is unchanged. */
  .install-row {
    position: relative;
  }

  .install-copy {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    z-index: 1;
    background: var(--sk-color-surface, #fff);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.85rem;
    margin-block: var(--docs-rhythm);
  }

  .facts sk-card {
    display: block;
    block-size: 100%;
  }

  /* The card is not a shadow root (ADR-011), so the internal body is reachable
     by its data-slot hook. Making it a flex column with space-between pins the
     label to the bottom, which is what keeps four cards of different number
     widths reading as one row rather than four staggered boxes. */
  .facts sk-card [data-slot="body"] {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    block-size: 100%;
  }

  .stat {
    display: block;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .why {
    margin-block: var(--docs-rhythm);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.85rem;
    margin-block-start: 1rem;
  }

  /* Same height per row: four cards of unequal height read as a misaligned
     grid, and the last one being 11px shorter was visible as a staggered
     bottom edge rather than as a design decision. */
  .why-grid sk-card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
  }

  .why-grid sk-card [data-slot="body"] {
    flex: 1;
  }

  .group {
    margin-block-start: var(--docs-rhythm);
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-block-end: 0.85rem;
  }

  .group-head sk-text {
    display: block;
  }

  /* Equal rows: summaries differ by a line or two, and without this the grid
     reads as staircased — cards in the same row ending at different heights.
     The card body absorbs the slack so the heading stays at the top. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.85rem;
  }

  /* The link wraps the card so the whole surface is clickable; the card is the
     visual, the anchor is the target. */
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-link sk-card {
    display: block;
    block-size: 100%;
  }

  /* -- Filterable catalogue --------------------------------------------------
     The filters are Santaka components in a flex row, so they sit on the
     component's own sizing rather than a hard-coded width: the field grows,
     the select keeps its intrinsic size, and both collapse on narrow screens. */
  .catalogue {
    margin-block-start: var(--docs-rhythm);
  }

  .catalogue-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-block-end: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    margin-block-end: 1.25rem;
    padding: 1rem;
    border: var(--docs-stroke) solid var(--docs-edge);
    border-radius: var(--sk-radius-md, 6px);
    background: var(--docs-raised);
  }

  .filters sk-input {
    flex: 1 1 18rem;
  }

  .filters sk-select {
    flex: 0 1 14rem;
  }

  /* A filtered-out card must leave the grid entirely, and it must also leave
     the tab order: the script sets hidden, which does both, so a keyboard user
     cannot land on a card they cannot see. */
  .card-link[hidden] {
    display: none;
  }

  /* Hover: the card lifts 2px and its shadow deepens one step — the same
     affordance the components give their own pressables. This was missing:
     a catalogue of 38 cards where nothing answered the pointer. */
  .card-link {
    transition:
      translate var(--sk-duration-control, 140ms) var(--sk-ease-arcade),
      box-shadow var(--sk-duration-control, 140ms) var(--sk-ease-arcade);
  }

  .card-link:hover {
    translate: 0 -2px;
  }

  .card-link:hover sk-card {
    /* Set the CUSTOM PROPERTY, not box-shadow: the component sets its own
       box-shadow from --sk-card-shadow internally, and a plain box-shadow here
       loses the cascade to it. The property is the public lever. */
    --sk-card-shadow: var(--sk-shadow-brutal-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link,
    .card-link:hover {
      transition: none;
      translate: none;
    }
  }

  .card-meta {
    display: flex;
    gap: 0.35rem;
    margin-block-start: 0.6rem;
  }

  .section-eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--docs-code);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--sk-color-primary);
  }

  .section-title {
    margin: 0;
    font-family: var(--sk-font-display, inherit);
    font-size: var(--sk-font-size-3xl, 1.875rem);
    font-weight: var(--sk-font-weight-bold, 800);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .hint {
    display: block;
    margin-block-end: 0.85rem;
    max-inline-size: 65ch;
  }

  .machine {
    margin-block-start: var(--docs-rhythm);
  }

  /* The terminal material: dark chrome + three dots, the visual shorthand for
     "this is where the machine reads". Same construction as the hero demo. */
  .machine-shell {
    border: var(--docs-stroke) solid var(--sk-color-ink, #1b1714);
    border-radius: var(--sk-radius-lg, 6px);
    background: var(--sk-color-ink, #1b1714);
    color: var(--sk-color-ink-50, #faf5ec);
    box-shadow: var(--sk-shadow-brutal, 5px 5px 0 0);
    overflow: hidden;
  }

  .machine-body {
    padding: 1.25rem 1.35rem 1.5rem;
    /* The shell's --docs-raised is mixed from the LIGHT surface, so inline
       code inside this dark panel rendered light-on-light and failed the
       contrast gate. The override re-mixes the raised tint from the panel's
       own ink so inline code keeps its pill without a light-on-light fill. */
    --docs-raised: rgb(250 245 236 / 0.08);
    --docs-edge: #6B5E52;
  }

  .machine .section-title,
  .machine-body sk-text {
    color: var(--sk-color-ink-50, #faf5ec);
  }

  .machine-body sk-text[muted] {
    color: #C9BCA8;
  }

  .machine .links li {
    color: #C9BCA8;
  }

  .machine .links code {
    color: var(--sk-color-ink-50, #faf5ec);
  }

  .machine > sk-text {

    display: block;
    margin-block-end: 0.5rem;
  }

  .machine ul.links {
    list-style: none;
    padding: 0;
    margin-block-start: 1rem;
    display: grid;
    gap: 0.4rem;
  }

  .machine li {
    font-size: 0.9rem;
    color: var(--sk-color-text-muted);
  }

  @media (max-width: 40rem) {
    .cards {
      grid-template-columns: 1fr;

  stability?.addEventListener("change", apply)
      gap: 0.5rem;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Bento: panels of different sizes on one grid, so the section reads as a
     composition rather than a list. Every panel is a real component; the grid
     only decides which is wide. */
  /* Twelve columns, not six: with every panel spanning half of six, the grid
     was doing nothing — all eight panels were the same width, and their heights
     ranged 142px to 335px because each held a different amount of content. The
     sizes below group the panels by what they hold, and grid-auto-rows with
     stretch makes every panel in a row the same height, which is what makes a
     bento read as composed rather than as eight boxes that happened to land
     next to each other. */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(0, auto);
    align-items: stretch;
    gap: 1rem;
    margin-block: var(--docs-rhythm);
  }

  /* Every panel fills its grid area and stretches to the tallest in its row,
     so the row has one height instead of one height per panel. */
  .bento > sk-card {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    block-size: 100%;
  }

  /* Sized by what each panel holds. The two form panels are the densest and get
     the most room; the small ones — avatars, range, loading — hold one idea and
     would look empty stretched across half the page. 6 + 6, then 4 + 4 + 4,
     then 4 + 4 + 4: three rows of twelve, no gaps in the layout. */
  .bento-form,
  .bento-signal {
    grid-column: span 6;
  }

  .bento-people,
  .bento-tabs,
  .bento-slider,
  .bento-table,
  .bento-overlays,
  .bento-loading {
    grid-column: span 4;
  }

  /* The card body takes the slack, so a short panel's content sits at the top
     rather than floating in the middle of a tall box. */
  .bento > sk-card [data-slot="body"] {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .bento-stack {
    display: grid;
    gap: 0.75rem;
  }

  /* How-it-works: the accordion is the system's own component, so the only
     thing set here is the measure — a line of prose should not run the full
     width of a wide viewport, or it stops being read. */
  .how-accordion {
    display: block;
    margin-block-start: 1rem;
    max-inline-size: 78ch;
  }

  .section-lede {
    display: block;
    margin-block-start: 0.5rem;
    max-inline-size: 65ch;
  }

  .popover-body {
    max-inline-size: 22rem;
  }

  .drawer-body {
    max-inline-size: 30ch;
  }

  .bento-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 62rem) {
    .bento {
      grid-template-columns: 1fr;
    }

    .bento > sk-card,
    .bento-form,
    .bento-signal,
    .bento-people,
    .bento-tabs,
    .bento-slider,
    .bento-table {
      grid-column: span 1;
      grid-row: auto;
    }
  }
</style>

<script>
  // A one-line install command is meant to be copied, not retyped. The button
  // reports its own outcome instead of relying on a toast, so the feedback is
  // where the reader is looking.
  const copy = document.getElementById("copy-install")
  copy?.addEventListener("click", async () => {
    const text = copy.getAttribute("data-copy") ?? ""
    try {
      await navigator.clipboard.writeText(text)
      copy.textContent = "Copied"
    } catch {
      copy.textContent = "Press Ctrl+C"
    }
    setTimeout(() => {
      copy.textContent = "Copy"
    }, 1600)
  })

  // The catalogue filter, driven by the components' own event. Both controls
  // dispatch sk-value-change for a user-initiated change (the shared wiring in
  // form-control-base.ts), so the page never reads a DOM property to find out
  // what the reader did. An earlier version listened for a native input event
  // and read host.value, which is a reflected attribute that had not been
  // written yet — every keystroke filtered on the previous character.
  const search = document.getElementById("filter-search")
  const stability = document.getElementById("filter-stability")
  const grid = document.getElementById("catalogue-grid")
  const empty = document.getElementById("catalogue-empty")

  const cards = grid ? [...grid.querySelectorAll<HTMLElement>(".card-link")] : []
  const toggle = document.getElementById("catalogue-toggle")

  // Twelve visible on load. The cap is on what is rendered, not on what is
  // searchable: the filter below runs over all of them, so "toast" still finds
  // sk-toast when it sits at position 30.
  const PAGE = 12
  let expanded = false

  const apply = (rawValue?: string) => {
    const source = (rawValue ?? (search as HTMLInputElement | null)?.value ?? "").toString()
    const q = source.trim().toLowerCase()
    // sk-select is a custom element, not a <select>: its value is empty until
    // the reader picks something, so empty has to mean "all" rather than being
    // matched against the option list and matching nothing.
    const stab = ((stability as HTMLSelectElement | null)?.value ?? "") || "all"

    let shown = 0
    for (const card of cards) {
      const haystack = `${card.dataset.tag ?? ""} ${card.dataset.name ?? ""} ${card.dataset.summary ?? ""}`.toLowerCase()
      const matches = (!q || haystack.includes(q)) && (stab === "all" || card.dataset.stability === stab)
      card.hidden = !matches
      if (matches) shown += 1
    }

    // Cap what stays visible unless the reader asked for all of them. The cap
    // is applied after the filter, so a filter that narrows to eight shows all
    // eight rather than eight of twelve.
    let visible = 0
    if (!expanded && !q && stab === "all") {
      for (const card of cards) {
        if (card.hidden) continue
        if (visible >= PAGE) card.hidden = true
        else visible += 1
      }
    } else {
      visible = shown
    }

    if (toggle) {
      const capped = !expanded && !q && stab === "all" && shown > PAGE
      toggle.hidden = shown <= PAGE
      toggle.textContent = capped ? `Show all ${shown} components` : "Show fewer"
    }

    // hidden removes the card from the grid and from the tab order, so a
    // keyboard user cannot land on a link they cannot see. The empty state
    // explains the blank grid instead of leaving it unexplained.
    if (empty) empty.hidden = visible > 0
  }

  // sk-value-change carries the committed value in detail and is the contract a
  // consumer should use — no property read, no timing assumption. It fires on
  // change, which for a search field is too late: the reader expects the grid to
  // narrow as they type. The native input event covers the keystrokes, and its
  // value is read from the event target rather than host.value, which is a
  // reflected attribute that lags by a tick.
  search?.addEventListener("sk-value-change", (event) => {
    apply(String((event as CustomEvent<{ value: string }>).detail?.value ?? ""))
  })
  search?.addEventListener("input", (event) => {
    const target = event.target as HTMLInputElement | null
    apply((target?.value ?? "").toString())
  })
  stability?.addEventListener("sk-value-change", () => apply())

  toggle?.addEventListener("click", () => {
    expanded = !expanded
    apply()
    // Keep the reader where they were: expanding a grid below the fold
    // otherwise jumps the page.
    if (!expanded) grid?.scrollIntoView({ block: "nearest" })
  })

  apply()
</script>
