---
/**
 * Site shell.
 *
 * The component CSS and token imports are the documented sequence (§4's
 * distribution contract): tokens, then the component stylesheet. Light/dark is an
 * attribute on the root element, which works before any script runs — the same
 * contract the components ship with (ADR-005, no flash of wrong theme).
 *
 * All styling lives in `src/styles/site.css`. It used to be duplicated here in a
 * `<style is:global>` block as well, which meant two sources of truth for the
 * same rules and a change that had to be made twice.
 */
import "../styles/global.css"
import Search from "../components/Search.astro"
import Sidebar from "../components/Sidebar.astro"

interface Props {
  title: string
  description?: string
  /** Render the component sidebar. Off on the landing page, where it would compete with the hero. */
  sidebar?: boolean
  /** Wider than a reading column, for pages whose content is a grid rather than prose. */
  wide?: boolean
}

const { title, description, sidebar = false, wide = false } = Astro.props
const path = Astro.url.pathname
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`)
---

<!doctype html>
<html lang="en" data-sk-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <script is:inline>
      // Applied before paint, so the page never flashes the wrong theme. The
      // stored preference wins; otherwise the system preference decides.
      try {
        const stored = localStorage.getItem("sk-theme")
        const dark =
          stored === "dark" ||
          (stored === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.setAttribute("data-sk-theme", dark ? "dark" : "light")
      } catch {}
    </script>

    {/*
      Canonical and social tags. `Astro.site` is the origin the build is told it
      will be served from (`astro.config.mjs`), so the canonical URL is generated
      rather than written — a hand-written one is the first thing to go stale
      when a host changes, and a wrong canonical is worse than none.
    */}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <a class="brand" href="/">
        <sk-taka size="sm" mood="idle" aria-hidden="true" />
        <span>Santaka UI</span>
      </a>
      <Search />
      <nav aria-label="Main">
        <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>Components</a>
        <a href="/showcase" aria-current={isCurrent("/showcase") ? "page" : undefined}>Showcase</a>
        <a href="/quick-start" aria-current={isCurrent("/quick-start") ? "page" : undefined}>Quick start</a>
        <a href="/registry/index.json">Registry</a>
        <a href="/llms.txt">llms.txt</a>
        <button id="theme-toggle" type="button" aria-label="Toggle dark theme" aria-pressed="false">◐</button>
      </nav>
    </header>

    <div class:list={["shell", sidebar && "shell--with-sidebar", wide && "shell--wide"]}>
      {sidebar && <Sidebar />}
      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site">
      {/* The strip label is the house chrome: mono uppercase with wide tracking,
          the same treatment every panel header on the site carries. */}
      <p class="footer-label">Santaka UI</p>
      <nav aria-label="Project">
        <a href="https://github.com/ifanshx/santaka-ui">GitHub</a>
        <a href="https://github.com/ifanshx/santaka-ui/blob/main/docs/ARCHITECTURE.md">Specification</a>
        <a href="https://github.com/ifanshx/santaka-ui/tree/main/docs/adr">Decisions</a>
        <a href="/registry/index.json">Registry</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/llms-full.txt">llms-full.txt</a>
      </nav>
      <p>MIT licensed. Every page is generated from the registry — nothing here is hand-maintained.</p>
    </footer>
  </body>
</html>

<script>
  // The elements are registered here, once, for the whole shell — not only in
  // the component previews. The mascot in the header is an `<sk-taka>`, and
  // without this it renders as an empty inline tag: the markup is there, the
  // stylesheet is bundled, and nothing upgrades. Registration is a side effect,
  // so it belongs in the browser only.
  import("@santaka-ui/web-components")
</script>

<script>
  // The toggle is the only script the shell needs. It writes the same attribute
  // the components read, so switching theme needs no re-render — and it keeps
  // `aria-pressed` in step, because a toggle that announces the wrong state is
  // worse than one that announces nothing.
  const toggle = document.getElementById("theme-toggle")
  const root = document.documentElement
  const isDark = () => root.getAttribute("data-sk-theme") === "dark"

  const paint = () => {
    toggle?.setAttribute("aria-pressed", String(isDark()))
    if (toggle) toggle.textContent = isDark() ? "◑" : "◐"
  }
  paint()

  toggle?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark"
    root.setAttribute("data-sk-theme", next)
    try {
      localStorage.setItem("sk-theme", next)
    } catch {}
    paint()
  })
</script>
