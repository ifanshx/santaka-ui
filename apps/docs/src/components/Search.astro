---
/**
 * Search UI.
 *
 * Pagefind is a build-time index served as static files, so this island loads
 * those files at runtime and searches in the browser. No API key, no hosted
 * service, and nothing leaves the page — which is why ADR-006 chose it over a
 * hosted search dependency.
 *
 * The index only exists after `pagefind --site dist` has run, so a missing index
 * is reported in the UI rather than failing the build: a dev server has no index,
 * and that must not look like a broken site.
 */
---

<div class="search" data-search>
  <label class="field">
    <span class="sr-only">Search the documentation</span>
    <input type="search" placeholder="Search components…" data-search-input autocomplete="off" />
    <span class="search-kbd" aria-hidden="true">
      <sk-kbd size="sm">⌘</sk-kbd><sk-kbd size="sm">K</sk-kbd>
    </span>
  </label>
  <ul class="results" data-search-results hidden></ul>
  <p class="status" data-search-status hidden></p>
</div>

<script>
  import type { PagefindModule, PagefindResult } from "../lib/pagefind"

  const root = document.querySelector("[data-search]")
  const input = root?.querySelector<HTMLInputElement>("[data-search-input]")

  // ⌘K / Ctrl+K focuses the search field, which is what the ⌘K badge in the
  // field promises. Registered once at the document level so it works even
  // when the field itself has never been focused.
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault()
      input?.focus()
      input?.select()
    }
  })
  const list = root?.querySelector<HTMLUListElement>("[data-search-results]")
  const status = root?.querySelector<HTMLParagraphElement>("[data-search-status]")

  let pagefind: PagefindModule | undefined
  try {
    // `@vite-ignore`: the bundle is written into `dist/pagefind/` by the
    // `pagefind --site dist` step, after Astro builds, so it does not exist when
    // this module is compiled. The path is absolute because the bundle sits at
    // the site root, not next to this component. It is held in a variable so the
    // specifier stays dynamic — there is no file for the type checker to resolve,
    // and a literal would be reported as a missing module.
    const bundlePath = "/pagefind/pagefind.js"
    pagefind = (await import(/* @vite-ignore */ bundlePath)) as PagefindModule
  } catch {
    if (status) {
      status.hidden = false
      status.textContent =
        "Search index not built. Run `pagefind --site dist` after the site build."
    }
    if (input) input.disabled = true
  }

  const render = async (results: PagefindResult[]): Promise<void> => {
    if (!list) return
    list.textContent = ""
    if (results.length === 0) {
      if (status) {
        status.hidden = false
        status.textContent = "No results."
      }
      list.hidden = true
      return
    }
    if (status) status.hidden = true
    list.hidden = false
    for (const result of results.slice(0, 10)) {
      const data = await result.data()
      const item = document.createElement("li")
      const link = document.createElement("a")
      link.href = data.url
      const title = document.createElement("strong")
      title.textContent = data.meta?.title ?? data.url
      const excerpt = document.createElement("span")
      // Pagefind's excerpt is HTML with <mark> around the match; it is built from
      // this site's own pages, so it is as trusted as the pages themselves.
      excerpt.innerHTML = data.excerpt ?? ""
      link.append(title, excerpt)
      item.appendChild(link)
      list.appendChild(item)
    }
  }

  let timer: ReturnType<typeof setTimeout> | undefined
  input?.addEventListener("input", () => {
    const query = input.value.trim()
    clearTimeout(timer)
    if (!query || !pagefind) {
      if (list) list.hidden = true
      if (status) status.hidden = true
      return
    }
    const active = pagefind
    timer = setTimeout(async () => {
      const search = (await active.debouncedSearch?.(query)) ?? (await active.search(query))
      await render(search?.results ?? [])
    }, 150)
  })
</script>

<style>
  .search {
    position: relative;
    max-inline-size: 24rem;
  }
  .field {
    display: block;
  }
  input {
    inline-size: 100%;
    padding: 0.35rem 0.6rem;
    /* The end padding leaves room for the ⌘K badge, which is the affordance
       the hero promises. */
    padding-inline-end: 4.2rem;
    border: var(--docs-stroke) solid var(--docs-edge);
    border-radius: var(--sk-radius-md, 4px);
    background: var(--sk-color-surface);
    color: inherit;
    font: inherit;
  }

  /* The badge is decorative (aria-hidden) and passive: the real shortcut is the
     document-level key handler below. */
  .search-kbd {
    position: absolute;
    inset-inline-end: 0.55rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    display: inline-flex;
    gap: 0.2rem;
    pointer-events: none;
  }

  .field {
    position: relative;
  }
  .results {
    position: absolute;
    inset-inline: 0;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--sk-color-surface);
    border: var(--docs-stroke) solid var(--docs-edge);
    z-index: 10;
    max-block-size: 22rem;
    overflow-y: auto;
  }
  .results a {
    display: block;
    padding: 0.4rem 0.6rem;
    text-decoration: none;
    color: inherit;
    border-block-end: 1px solid var(--docs-edge);
  }
  .results a:hover {
    background: var(--docs-raised);
  }
  .results span {
    display: block;
    font-size: 0.8rem;
    color: var(--docs-muted);
  }
  .status {
    font-size: 0.8rem;
    color: var(--docs-muted);
    margin: 0.25rem 0 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
