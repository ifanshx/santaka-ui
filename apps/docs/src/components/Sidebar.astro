---
/**
 * The component sidebar.
 *
 * Every documentation site with more than a handful of components needs one,
 * and this one was the site's largest structural gap: 38 components existed and
 * the only way to reach one was to go back to the index and scan a grid. A
 * reader comparing `sk-select` with `sk-combobox` had to navigate twice.
 *
 * The list is derived from the registry, like everything else — adding a
 * component makes it appear here without an edit.
 */
import { componentPages, stabilityGroups } from "../lib/components"

const groups = stabilityGroups()
const path = Astro.url.pathname

/** A page is current when the path is its page, not when it merely starts with it. */
const isCurrent = (name: string) => path === `/components/${name}/`
---

<aside class="sidebar" aria-label="Components">
  <nav aria-label="Component list">
    {
      groups.map((group) => (
        <div class="side-group">
          <p class="side-label">
            {group.label}
            <span class="side-count">{group.pages.length}</span>
          </p>
          <ul>
            {group.pages.map((page) => (
              <li>
                <a
                  href={`/components/${page.name}/`}
                  aria-current={isCurrent(page.name) ? "page" : undefined}
                >
                  {page.tag}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="side-group">
      <p class="side-label">Reference</p>
      <ul>
        <li><a href="/quick-start/">Quick start</a></li>
        <li><a href="/showcase/">Showcase</a></li>
        <li><a href="/guides/accessibility/">Accessibility</a></li>
        <li><a href="/guides/theming/">Theming</a></li>
        <li><a href="/guides/forms/">Forms</a></li>
        <li><a href="/guides/ssr/">SSR</a></li>
        <li><a href="/guides/cli/">CLI</a></li>
      </ul>
    </div>
  </nav>
</aside>

<style>
  .sidebar {
    position: sticky;
    inset-block-start: 4.25rem;
    align-self: start;
    max-block-size: calc(100vh - 5.5rem);
    overflow-y: auto;
    padding-inline-end: 0.5rem;
    font-size: 0.86rem;
    /* A thin scrollbar rather than the platform default: the list is long and
       the default track is visually louder than the links it sits beside. */
    scrollbar-width: thin;
  }

  .side-group + .side-group {
    margin-block-start: 1.5rem;
  }

  .side-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--docs-muted);
  }

  .side-count {
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar li a {
    display: block;
    padding: 0.25rem 0.55rem;
    border-inline-start: 2px solid transparent;
    color: var(--docs-muted);
    text-decoration: none;
    font-size: 0.84rem;
  }

  .sidebar li a:hover {
    color: var(--sk-color-text);
    background: var(--docs-raised);
  }

  .sidebar li a[aria-current="page"] {
    color: var(--sk-color-text);
    border-inline-start-color: var(--sk-color-primary);
    background: var(--docs-raised);
    font-weight: 700;
  }
</style>

<script>
  // The list is 38 entries long, so the current page is often below the fold.
  // Scrolling it into view on load is what makes the sidebar answer "where am I"
  // instead of leaving the reader to hunt for the highlighted row.
  const current = document.querySelector('.sidebar a[aria-current="page"]') as HTMLElement | null
  const aside = document.querySelector(".sidebar")
  if (current && aside && aside.scrollHeight > aside.clientHeight) {
    const top = current.offsetTop - aside.clientHeight / 2
    aside.scrollTo({ top: Math.max(0, top), behavior: "instant" })
  }
</script>
