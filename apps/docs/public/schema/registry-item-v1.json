{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://santaka.my.id/schema/registry-item-v1.json",
  "title": "Santaka UI registry item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "namespace",
    "type",
    "frameworks",
    "stability",
    "behaviorOwner",
    "version",
    "dependencies",
    "peerDependencies",
    "registryDependencies",
    "files",
    "cssVariables",
    "localesCovered",
    "license",
    "ai"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "namespace": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "type": {
      "enum": [
        "component",
        "block",
        "theme",
        "utility"
      ]
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "react",
          "vue",
          "svelte",
          "angular",
          "web-components"
        ]
      }
    },
    "stability": {
      "enum": [
        "stable",
        "preview",
        "experimental",
        "deprecated"
      ]
    },
    "behaviorOwner": {
      "enum": [
        "web-components",
        "react",
        "framework-neutral"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "peerDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "checksum"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "pattern": "^sha256-[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "cssVariables": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^--sk-"
      }
    },
    "localesCovered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sk-[a-z0-9-]+$"
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "whenToUse",
        "whenNotToUse",
        "accessibility",
        "example",
        "localesCovered",
        "knownLimitations"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "whenToUse": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "whenNotToUse": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "accessibility": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "localesCovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
